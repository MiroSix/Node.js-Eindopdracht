# Poort waarop de server draait
PORT=3000

# MongoDB verbindingsstring (lokaal of Atlas)
MONGODB_URI=mongodb://localhost:27017/gaming-tournament

# Geheime sleutel voor JWT signing — gebruik een lang willekeurig geheim in productie
JWT_SECRET=vervang-dit-door-een-lang-willekeurig-geheim

# Vervaltijd van JWT tokens (bv. 1h, 7d, 30m)
JWT_EXPIRES_IN=1h

# Omgeving: development | production | test
NODE_ENV=development
